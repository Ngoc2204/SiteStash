# PostgreSQL Database Connection URL (Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitestash?schema=public"

# NextAuth / Auth Secret
AUTH_SECRET="sitestash_super_secret_jwt_key_2026_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Admin Access Credentials (Default Admin for quick access & management)
ADMIN_EMAIL="admin@sitestash.io"
ADMIN_PASSWORD="admin123@password"

# Telegram Webhook Bot Notification (Optional - Leave empty to mock log)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# App Domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"
